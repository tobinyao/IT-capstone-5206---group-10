# Copy this file to `.env.local` (git-ignored) and adjust the values.
#
# Base URL of the backend API. Leave empty to send requests to the same
# origin (useful when a reverse proxy or the dev server forwards /api/*
# to the backend). Set to a full origin like "https://api.example.com"
# to point the frontend at a remote backend.
VITE_API_BASE_URL=
